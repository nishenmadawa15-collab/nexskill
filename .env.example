# Copy this file to .env.local and fill in the values from your Supabase project's
# Settings -> API page (https://supabase.com/dashboard/project/_/settings/api).

# Public — safe to expose to the browser, used by every client/server Supabase call.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. Used exclusively by scripts/seed.mjs via lib/supabaseAdmin.js
# to provision demo auth users. Never import lib/supabaseAdmin.js from app/, and never
# set this as a client-exposed env var.
SUPABASE_SERVICE_ROLE_KEY=
